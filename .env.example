# 阿里云OSS配置
# 请复制此文件为 .env.local 并填入真实的配置信息

# OSS访问密钥ID
OSS_ACCESS_KEY_ID=your_access_key_id

# OSS访问密钥Secret
OSS_ACCESS_KEY_SECRET=your_access_key_secret

# OSS存储桶名称（默认：investment-report）
OSS_BUCKET=investment-report

# OSS区域（默认：oss-cn-beijing）
OSS_REGION=oss-cn-beijing

# OSS上传目录前缀（可选，留空表示上传到根目录）
OSS_DIR=

# 构建模式（development/test/staging/production）
NODE_ENV=production
