# 页面标题
VITE_APP_TITLE = 招商报告

# open 运行 npm run dev 时自动打开浏览器
VITE_OPEN = false

# 打包是否开启 cdn（源文件 utils/build.ts），可自行修改
VITE_OPEN_CDN = false

# public path 配置线上环境路径（打包）、本地通过 http-server 访问时，请置空即可
VITE_PUBLIC_PATH = /

# 是否允许在 iframe 中运行
VITE_ALLOW_IFRAME=true

#允许嵌入的路径
VITE_ALLOWED_EMBED_PATHS=/report/detail/*,/report/view/*,/dashboard/*

# 允许嵌入的父域名
VITE_ALLOWED_EMBED_ORIGINS=https://parent1.com,https://parent2.com